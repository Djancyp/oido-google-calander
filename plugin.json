{
  "id": "oido-google-calendar",
  "name": "Oido Google Calendar",
  "version": "1.0.0",
  "description": "List, create, search, and read Google Calendar events via Service Account using MCP server.",
  "type": "extension",
  "enabled": true,
  "binary": "oido-google-calendar-mcp",
  "protocol_version": 1,
  "os": ["linux", "darwin"],
  "arch": ["amd64", "arm64"],
  "config_schema": {},
  "capabilities": ["g_calendar_list_events", "g_calendar_get_event", "g_calendar_create_event", "g_calendar_search_events"],
  "author": "oido-studio",
  "homepage": "https://calendar.google.com"
}
